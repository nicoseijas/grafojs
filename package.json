{
  "name": "grafojs",
  "version": "0.1.0",
  "description": "Build and animate declarative SVG scenes of nodes and edges. Framework-agnostic, backed by an immutable graph core.",
  "license": "MIT",
  "author": "Nicolás Seijas <nicoseijas@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicoseijas/grafojs.git"
  },
  "bugs": {
    "url": "https://github.com/nicoseijas/grafojs/issues"
  },
  "homepage": "https://github.com/nicoseijas/grafojs#readme",
  "keywords": [
    "svg",
    "diagram",
    "visualization",
    "animation",
    "architecture-diagram",
    "graph",
    "typescript"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./visual": {
      "types": "./dist/visual/index.d.ts",
      "default": "./dist/visual/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "default": "./dist/layout/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "default": "./dist/adapters/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "audit": "npm audit --audit-level=high",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:package",
    "clean": "node scripts/clean.mjs",
    "prepack": "npm run build",
    "example:basic": "npm run build && node examples/basic.mjs",
    "example:components": "npm run build && node examples/components.mjs",
    "example:adapters": "npm run build && node examples/graph-to-scene.mjs",
    "example:paths": "npm run build && node examples/shortest-paths.mjs",
    "example:visual": "npm run build && node examples/visual.mjs",
    "example:visual:browser": "npm run build && node examples/serve-visual.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "npm run build && node --test test/package.test.mjs && node scripts/verify-package.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "happy-dom": "^20.11.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
